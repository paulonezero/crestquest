# Required only by the seasonal football-data.org importer.
FOOTBALL_DATA_API_KEY=

# Required in production. Generate a unique value with: openssl rand -hex 32
CREST_QUEST_SESSION_SECRET=
CREST_QUEST_ENV=development

# Railway should point this at a persistent volume for leaderboard durability.
CREST_QUEST_LEADERBOARD_PATH=var/leaderboard.sqlite3
